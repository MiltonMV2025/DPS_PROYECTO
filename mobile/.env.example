# URL del backend (Next.js). Copia este archivo a .env y elige UNA opcion.
#
# 1) Emulador de Android (el emulador ve el host en 10.0.2.2):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# 2) Telefono fisico: usa la IP de tu PC en la red WiFi y arranca el backend con
#    "npm run dev -- -H 0.0.0.0" desde la raiz del repo:
# EXPO_PUBLIC_API_URL=http://192.168.X.X:3000
#
# 3) Backend desplegado en Vercel:
# EXPO_PUBLIC_API_URL=https://dps-proyecto.vercel.app
#
# Opcional: registrar el dispositivo para notificaciones push (requiere development build).
# EXPO_PUBLIC_ENABLE_PUSH=false
