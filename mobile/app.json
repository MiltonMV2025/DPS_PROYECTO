{
  "expo": {
    "name": "Sonrisa Digital",
    "slug": "sonrisa-digital-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sonrisadigital",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": { "kotlinVersion": "2.1.20" },
          "ios": { "useFrameworks": "dynamic" }
        }
      ],
      "./plugins/with-kotlin-gradle-classpath",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "react-native-nitro-google-signin"
    ],
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.sonrisadigital.mobile"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.sonrisadigital.mobile"
    }
  }
}
