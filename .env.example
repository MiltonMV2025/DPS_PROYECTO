# MySQL connection string. URL-encode reserved characters in credentials.
DATABASE_URL=mysql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BASE_DATOS

# Secret used to sign session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=generar-un-secreto-propio-y-no-compartirlo

# Separate secret for Mobile Bearer access tokens. Never reuse AUTH_SECRET.
MOBILE_AUTH_SECRET=replace-with-a-different-32-character-secret

# Server-only secret for internal read-only Route Handlers. Never use NEXT_PUBLIC_.
INTERNAL_API_SECRET=change-me
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
