# Copiar este archivo como .env.local y reemplazar cada valor.
# NUNCA escribir credenciales reales aqui: este archivo si se versiona en Git.

# Cadena de conexion MySQL. Codificar en URL los caracteres reservados.
DATABASE_URL=mysql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BASE_DATOS

# Secreto para firmar los tokens de sesion. Generar uno propio con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=generar-un-secreto-propio-y-no-compartirlo

# Secreto de las Route Handlers internas de solo lectura. Nunca usar NEXT_PUBLIC_.
INTERNAL_API_SECRET=generar-otro-secreto-distinto
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
